# 复制为 .env 后填写。.env 绝不入库（见根 .gitignore）。
# 桩服务阶段只需前三项；接真实模型时改 JXL_PROVIDER=model 并配置 JXL_MODELS + 对应密钥。

JXL_PROVIDER=fixture
JXL_MAX_BODY_BYTES=8388608
JXL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- 多厂家配置
# JXL_MODELS 里只写「密钥的环境变量名」，不写密钥本身，所以这段可以入库、可以发给队友。
# 缺密钥的 profile 会自动跳过；按数组顺序（或 JXL_MODEL_ORDER）依次尝试，失败自动降级到下一个。
#
# protocol 三选一：
#   openai    —— 兼容 OpenAI / DeepSeek / Kimi / 智谱 / 通义兼容模式 / 硅基流动 / OpenRouter / Ollama / vLLM
#                base_url 要带 /v1，例：https://api.deepseek.com/v1
#   anthropic —— base_url 不带版本，例：https://api.anthropic.com
#   gemini    —— base_url 不带版本，例：https://generativelanguage.googleapis.com
#
# 可选字段：timeout_s(90) max_tokens(2048) json_mode(true) retries(0) extra_body({})
# base_url 与 base_url_env 二选一：后者只写环境变量名，适合 base_url 也在环境里的情况。
# extra_body 会原样合并进请求体，用来放厂家特有开关。
#   思考模型（如 qwen3.8-flash）做结构化抽取不需要思维链：加 {"enable_thinking": false}
#   实测同一 prompt 从 ~39s 降到 ~10s，且避免思考过长撞超时。
# 本地模型不需要真密钥，但 api_key_env 指向的变量必须非空，随便填个 local 即可。

JXL_MODELS=[{"name":"qwen","protocol":"openai","base_url_env":"DASHSCOPE_BASE_URL","model":"qwen3.8-flash","api_key_env":"DASHSCOPE_API_KEY","extra_body":{"enable_thinking":false}},{"name":"deepseek","protocol":"openai","base_url":"https://api.deepseek.com/v1","model":"deepseek-chat","api_key_env":"DEEPSEEK_API_KEY"},{"name":"kimi","protocol":"openai","base_url":"https://api.moonshot.cn/v1","model":"moonshot-v1-8k-vision-preview","api_key_env":"MOONSHOT_API_KEY"},{"name":"glm","protocol":"openai","base_url":"https://open.bigmodel.cn/api/paas/v4","model":"glm-4v-flash","api_key_env":"ZHIPU_API_KEY"},{"name":"claude","protocol":"anthropic","base_url":"https://api.anthropic.com","model":"claude-sonnet-4-5","api_key_env":"ANTHROPIC_API_KEY"},{"name":"gemini","protocol":"gemini","base_url":"https://generativelanguage.googleapis.com","model":"gemini-2.5-flash","api_key_env":"GEMINI_API_KEY"},{"name":"local","protocol":"openai","base_url":"http://127.0.0.1:11434/v1","model":"qwen2.5vl:7b","api_key_env":"OLLAMA_API_KEY","json_mode":false}]

# 可选：显式指定尝试顺序（逗号分隔的 profile name）。留空则按 JXL_MODELS 数组顺序。
JXL_MODEL_ORDER=

# 可选：访问境外厂家需要代理时显式填写。
# 模型调用一律 trust_env=False，不读系统 HTTP_PROXY/NO_PROXY——本机 NO_PROXY 含 [::1]，
# httpx 会把它当 URL 解析并抛 InvalidURL，导致所有模型调用失败。
JXL_HTTPS_PROXY=

# ---------------------------------------------------------------- 密钥
# 只填你实际拥有的那几把，其余留空即可（对应 profile 会被跳过）。
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=local
