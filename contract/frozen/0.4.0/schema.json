{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "截下来 API 与本地领域契约",
  "schema_version": "0.4.0",
  "source_of_truth": "contract/models.py",
  "x-semantics": {
    "fields": {
      "notice": {
        "title": "标题",
        "requirement": "要做什么、提交什么材料；多条可用字符串数组",
        "deadline": "行动时间节点：提交类取最早硬性提交/完成截止；活动/宣讲/培训类取最早开始时间；其余节点进 constraints；不要把多个日期拼进一个 value",
        "constraints": "字数/格式/实验组数等硬性限制，以及带标签的时间窗口、地点、其余场次或截止节点；字符串或字符串数组",
        "submit_to": "提交入口或提交对象",
        "reminder": "逾期后果、提醒类语句；不要放进 constraints",
        "time_nodes": "全部时间节点（notice 必须输出，不得只给 deadline）：每节点 label/raw/value/basis/role/reference_at/reference_source/message_date；role 候选 submission_deadline/event_start/event_end/other/unknown；reference_source 只能 message_date/user；deadline 由后端仅从 submission_deadline 选主"
      },
      "tutorial": {
        "title": "标题",
        "deadline": "如有明确时间节点（提交/截止）则填；无则 missing",
        "summary": "概括原文；可归纳但 quote 必须指向支撑片段",
        "steps": "操作步骤；段落叙述也归纳成字符串数组",
        "cautions": "注意事项；字符串数组"
      },
      "reference": {
        "title": "标题",
        "deadline": "如有明确时间节点（提交/截止）则填；无则 missing",
        "summary": "概括原文；可归纳但 quote 必须指向支撑片段",
        "keywords": "检索关键词；字符串数组"
      }
    },
    "status": {
      "candidate": "原文可确定的事实候选，待用户确认；value 不得为 null",
      "unresolved": "仅用于原文时间或事实无法确定（相对时间、缺年份、模糊表述）；多场次/多选项是确定事实，用 candidate+数组，不得标 unresolved",
      "missing": "原文没写；value=null、raw=\"\"；绝不推测补造",
      "confirmed": "只能由用户标记，模型不得输出；用户确认推算值保留 derived=true 与原文引用，且不改变值来源 origin（确认≠改值，origin 仍可为 model）；用户实际改值才标 origin=user"
    },
    "time_rules": [
      "所有时间节点抽进 time_nodes，并给候选 role：submission_deadline（提交/完成截止）/event_start/event_end/other/unknown；basis 只能取 explicit（原文明确）/relative（相对换算）/inferred（补年）/superseded（被取代）；不得用 label 关键词代替 role",
      "活动开始、结束、补班日、背景日期不是 submission_deadline；它们保留在 time_nodes 按角色展示，不自动成为任务截止",
      "被新通知取代的旧日期标 basis=superseded，保留供溯源，不参与选主",
      "相对时间由你换算并标 basis=relative，且必须给 reference_at 与 reference_source：可靠参照只有两种——消息自身明确的绝对日期（message_date，reference_at 必须等于它）或用户指定参照（user，请求里会给出）；保存/收集时间 captured_at 永远不是可靠参照，当天保存也不行",
      "无可靠参照时相对节点 value=null、unresolved，展示原文；换算不出允许空，不硬算",
      "只有月日没有年份：参照可靠 reference_at 补年，basis=inferred",
      "原文明确绝对日期：value 用 YYYY-MM-DD；只有日期不补时刻（不补 23:59）；原文带时刻才用完整 ISO 日期时间",
      "「24:00」表示当日结束：输出 date 精度，不要输出 T24:00",
      "不要自行补时区：原文没有的时区不要写进 value",
      "deadline 由后端仅从 role=submission_deadline 且非 superseded 的节点中、在可比较候选里取最早；无有效截止或角色/比较关系不明时 deadline 缺席或为空，交用户选择"
    ],
    "chat_rules": [
      "聊天窗口截图只整理主消息气泡正文；忽略侧栏会话列表、群成员列表、与气泡无关的群公告",
      "不得把成员昵称或老师姓名当作 submit_to / reminder",
      "气泡内引用或转发的其它通知以气泡正文为准"
    ],
    "exclusion_rules": [
      "礼貌语（请知悉/谢谢/收到请回复）、纯背景原因（如「因平台维护」）、宣传鼓励语不进任何字段；只有当原因构成限制或后果时才进 constraints / reminder",
      "只输出原文事实候选，不输出行动建议，不把推测写成要求",
      "每个 candidate/unresolved 字段必须带 raw 与 quote.text，逐字摘自原文不得改写；概括类字段（summary/keywords）的 quote 指向支撑片段"
    ]
  },
  "endpoints": [
    {
      "path": "/api/analyze",
      "method": "POST",
      "phase": "P0",
      "request": "AnalyzeRequest",
      "response": "AnalyzeResponse",
      "errors": {
        "413": "图片超出体积上限；前端提示压缩后重试，原图已在本地",
        "422": "模型输出不合 schema 或请求非法；前端落 Note.status=failed，保留原图，可重试",
        "503": "模型不可用；前端隐藏 AI 入口但保留仅保存"
      },
      "idempotency": "source_id 由客户端生成；同一 source_id 重试不得产生第二份资料"
    },
    {
      "path": "/api/healthz",
      "method": "GET",
      "phase": "P0",
      "request": null,
      "response": "HealthResponse",
      "errors": {
        "503": "服务不可达；前端进入离线态，本地功能全部照常"
      },
      "idempotency": "只读"
    },
    {
      "path": "/api/match",
      "method": "POST",
      "phase": "P1",
      "request": "MatchRequest",
      "response": "MatchResponse",
      "errors": {
        "422": "请求非法",
        "503": "模型不可用；静默跳过建议，不阻塞归组"
      },
      "idempotency": "只读建议，无副作用"
    },
    {
      "path": "/api/suggest-action",
      "method": "POST",
      "phase": "P1",
      "request": "SuggestActionRequest",
      "response": "SuggestActionResponse",
      "errors": {
        "422": "请求非法或 basis=requirement 却无 evidence",
        "503": "不可用；手动填写行动仍可开始专注"
      },
      "idempotency": "只读建议，无副作用"
    },
    {
      "path": "/api/parse-tasks",
      "method": "POST",
      "phase": "P1",
      "request": "ParseTasksRequest",
      "response": "ParseTasksResponse",
      "errors": {
        "422": "请求非法",
        "503": "不可用；退回结构化批量录入"
      },
      "idempotency": "只读解析，结果必须经用户确认才入库"
    }
  ],
  "$defs": {
    "Quote": {
      "additionalProperties": false,
      "description": "原文引用。引用存在不等于已核实（PRD 规则 4）。",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "text",
        "source_id"
      ],
      "title": "Quote",
      "type": "object"
    },
    "TimeNode": {
      "additionalProperties": false,
      "description": "v0.3：一个时间节点。模型给候选角色与参照，后端按语义选主，不靠 label 关键词或任意最小值。",
      "properties": {
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "raw": {
          "default": "",
          "title": "Raw",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "precision": {
          "anyOf": [
            {
              "enum": [
                "date",
                "datetime"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision"
        },
        "tz_known": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tz Known"
        },
        "basis": {
          "default": "explicit",
          "enum": [
            "explicit",
            "relative",
            "inferred",
            "superseded"
          ],
          "title": "Basis",
          "type": "string"
        },
        "role": {
          "default": "unknown",
          "enum": [
            "submission_deadline",
            "event_start",
            "event_end",
            "other",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        },
        "reference_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference At"
        },
        "reference_source": {
          "anyOf": [
            {
              "enum": [
                "message_date",
                "user"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Source"
        },
        "message_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Date"
        },
        "derived": {
          "default": false,
          "title": "Derived",
          "type": "boolean"
        }
      },
      "title": "TimeNode",
      "type": "object"
    },
    "FieldOrigin": {
      "enum": [
        "model",
        "user"
      ],
      "title": "FieldOrigin",
      "type": "string"
    },
    "FieldStatus": {
      "enum": [
        "candidate",
        "confirmed",
        "unresolved",
        "missing"
      ],
      "title": "FieldStatus",
      "type": "string"
    },
    "Field": {
      "additionalProperties": false,
      "description": "便签的每个重要字段。一个结构承载规则 2/4/7 与 F03 的字段级确认。",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "raw": {
          "default": "",
          "title": "Raw",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/FieldOrigin",
          "default": "model"
        },
        "status": {
          "$ref": "#/$defs/FieldStatus",
          "default": "candidate"
        },
        "derived": {
          "default": false,
          "title": "Derived",
          "type": "boolean"
        },
        "quote": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quote"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "precision": {
          "anyOf": [
            {
              "enum": [
                "date",
                "datetime"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision"
        },
        "tz_known": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tz Known"
        }
      },
      "required": [
        "key"
      ],
      "title": "Field",
      "type": "object",
      "if": {
        "properties": {
          "key": {
            "const": "time_nodes"
          }
        },
        "required": [
          "key"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/TimeNode"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "Deadline": {
      "additionalProperties": false,
      "description": "只有日期就保持日期精度，不补 23:59（PRD F07）。来源可为便签或用户手动（P05）。",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "precision": {
          "default": "none",
          "enum": [
            "none",
            "date",
            "datetime"
          ],
          "title": "Precision",
          "type": "string"
        },
        "source": {
          "default": "note",
          "enum": [
            "note",
            "manual"
          ],
          "title": "Source",
          "type": "string"
        },
        "from_note_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Note Id"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed At"
        }
      },
      "title": "Deadline",
      "type": "object"
    },
    "Warning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "demo_data",
            "origin_unknown",
            "relative_date_derived",
            "date_year_inferred",
            "candidate_without_value",
            "timezone_unspecified",
            "possible_deadline_change",
            "no_deadline_in_source",
            "deadline_unselectable"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "field_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Key"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Warning",
      "type": "object"
    },
    "ContentType": {
      "enum": [
        "notice",
        "tutorial",
        "reference"
      ],
      "title": "ContentType",
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "image",
        "text"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "AnalyzeRequest": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "image_base64": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Base64"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "captured_at": {
          "title": "Captured At",
          "type": "string"
        },
        "content_hint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContentType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference At"
        }
      },
      "required": [
        "source_id",
        "kind",
        "captured_at"
      ],
      "title": "AnalyzeRequest",
      "type": "object"
    },
    "AnalyzeResponse": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "content_type": {
          "$ref": "#/$defs/ContentType"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/Field"
          },
          "title": "Fields",
          "type": "array"
        },
        "warnings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Warning"
          },
          "title": "Warnings",
          "type": "array"
        },
        "analyzed_at": {
          "title": "Analyzed At",
          "type": "string"
        },
        "model_name": {
          "title": "Model Name",
          "type": "string"
        },
        "schema_version": {
          "default": "0.4.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "content_type",
        "fields",
        "analyzed_at",
        "model_name"
      ],
      "title": "AnalyzeResponse",
      "type": "object"
    },
    "HealthResponse": {
      "additionalProperties": false,
      "properties": {
        "model_ready": {
          "title": "Model Ready",
