        },
        "api_version": {
          "default": "v1",
          "title": "Api Version",
          "type": "string"
        },
        "schema_version": {
          "default": "0.4.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "model_ready"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
    "MatterBrief": {
      "additionalProperties": false,
      "properties": {
        "id": {
