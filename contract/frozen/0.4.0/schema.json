          "default": [],
          "items": {
            "$ref": "#/$defs/MatchSuggestion"
          },
          "title": "Suggestions",
          "type": "array"
        }
      },
      "title": "MatchResponse",
      "type": "object"
    },
    "SuggestActionRequest": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "confirmed_fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Field"
          },
          "title": "Confirmed Fields",
          "type": "array"
        },
        "available_minutes": {
          "title": "Available Minutes",
          "type": "integer"
        },
        "note_summaries": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Note Summaries",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "title",
        "available_minutes"
      ],
      "title": "SuggestActionRequest",
      "type": "object"
    },
    "ActionBasis": {
      "enum": [
        "requirement",
        "suggestion",
        "user"
      ],
      "title": "ActionBasis",
      "type": "string"
    },
    "SuggestActionResponse": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "minutes": {
          "title": "Minutes",
          "type": "integer"
        },
        "basis": {
          "$ref": "#/$defs/ActionBasis"
        },
        "evidence": {
          "anyOf": [
            {
